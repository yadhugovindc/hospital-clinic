# --- Backend configuration ------------------------------------------------
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=4000

# MongoDB connection string. Use a single-node replica set locally so that
# multi-document transactions work (see docs/DEPLOYMENT.md).
MONGODB_URI=
# Access-token signing secret. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Access token lifetime in minutes
ACCESS_TOKEN_TTL_MINUTES=60

# CORS + CSRF allowed frontend origins. Add the current ngrok URL to this
# comma-separated list when tunneling (for example, https://your-name.ngrok-free.app).
FRONTEND_URL=http://localhost:5173

# Set to "true" in production (behind HTTPS) so cookies are Secure
COOKIE_SECURE=false

LOG_LEVEL=info
RATE_LIMIT_LOGIN_MAX=10

# Optional: used by `npm run seed:admin` to create the first admin non-interactively
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-min-8-chars
